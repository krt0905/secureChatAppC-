<Window x:Class="Chat.Client.Wpf.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatApp - Chat"
        Height="650" Width="1000"
        MinHeight="500" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FB">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#18263A" Padding="20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="ChatApp"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="UsernameLabel"
                               Foreground="#B9C6D8"
                               Margin="0,8,0,24"/>

                    <TextBlock Text="ĐANG TRỰC TUYẾN"
                               Foreground="#A8E6CF"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>
                </StackPanel>

                <ListBox x:Name="OnlineUsersList"
                         Background="#25364D"
                         Foreground="White"
                         BorderThickness="0"
                         Padding="4"/>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Trò chuyện"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#172033"
                       Margin="0,0,0,16"/>

            <ListBox x:Name="MessagesList"
                     Grid.Row="1"
                     Background="White"
                     BorderBrush="#E4E7EC"
                     Padding="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     DisplayMemberPath="Text"/>

            <Button x:Name="HistoryButton"
                    Grid.Row="2"
                    Content="Tải tin nhắn cũ hơn"
                    HorizontalAlignment="Left"
                    Margin="0,10,0,10"
                    Padding="12,7"
                    Click="HistoryButton_Click"/>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageTextBox"
                         Grid.Column="0"
                         MinHeight="44"
                         MaxHeight="100"
                         Padding="12"
                         FontSize="14"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         KeyDown="MessageTextBox_KeyDown"/>

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="Gửi"
                        Margin="10,0,0,0"
                        Background="#3978F6"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Click="SendButton_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
