<Window x:Class="Chat.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatApp"
        Height="600"
        Width="1000"
        MinHeight="520"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FB">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Left branding panel -->
        <Border Grid.Column="0" Background="#18263A">
            <Grid Margin="44">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42"
                            CornerRadius="12"
                            Background="#3978F6">
                        <TextBlock Text="C"
                                   Foreground="White"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ChatApp"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="Kết nối mọi người."
                               Foreground="White"
                               FontSize="34"
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Một không gian trò chuyện riêng của bạn."
                               Foreground="#B9C6D8"
                               FontSize="16"
                               Margin="0,18,0,0"
                               TextWrapping="Wrap"/>
                    <Border Background="#25364D"
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,32,0,0">
                        <StackPanel>
                            <TextBlock Text="●  Kết nối bảo mật"
                                       Foreground="#A8E6CF"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Được bảo vệ bằng kết nối TLS."
                                       Foreground="#D2DBE8"
                                       Margin="0,8,0,0"
                                       FontSize="13"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="ChatApp · .NET 8"
                           Foreground="#8494AA"
                           FontSize="12"/>
            </Grid>
        </Border>

        <!-- Right login panel -->
        <Grid Grid.Column="1" Margin="42">
            <StackPanel VerticalAlignment="Center"
                        MaxWidth="360"
                        HorizontalAlignment="Stretch">

                <TextBlock Text="Chào mừng trở lại"
                           FontSize="29"
                           FontWeight="Bold"
                           Foreground="#172033"/>

                <TextBlock Text="Đăng nhập để tiếp tục trò chuyện."
                           FontSize="14"
                           Foreground="#667085"
                           Margin="0,10,0,30"/>

                <TextBlock Text="Tên tài khoản"
                           FontWeight="SemiBold"
                           Foreground="#344054"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="UsernameTextBox"
                         Height="44"
                         FontSize="15"
                         Padding="12,8"
                         BorderBrush="#D0D5DD"
                         Background="White"
                         VerticalContentAlignment="Center"
                         ToolTip="Nhập tên tài khoản"/>

                <TextBlock Text="Mật khẩu"
                           FontWeight="SemiBold"
                           Foreground="#344054"
                           Margin="0,20,0,8"/>

                <PasswordBox x:Name="PasswordInput"
                             Height="44"
                             FontSize="15"
                             Padding="12,8"
                             BorderBrush="#D0D5DD"
                             Background="White"
                             VerticalContentAlignment="Center"/>

                <TextBlock x:Name="StatusTextBlock"
                           Text=""
                           Foreground="#D92D20"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0"/>

                <Button x:Name="LoginButton"
                        Content="Đăng nhập"
                        Height="46"
                        Margin="0,22,0,0"
                        Background="#3978F6"
                        Foreground="White"
                        FontSize="15"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="LoginButton_Click"/>

                <Button x:Name="RegisterButton"
                        Content="Tạo tài khoản"
                        Height="44"
                        Margin="0,12,0,0"
                        Background="White"
                        Foreground="#344054"
                        FontSize="14"
                        BorderBrush="#D0D5DD"
                        Cursor="Hand"
                        Click="RegisterButton_Click"/>

                <TextBlock Text="Kết nối tới máy chủ ChatApp"
                           Foreground="#98A2B3"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,28,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>