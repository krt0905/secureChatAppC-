
<Window x:Class="Chat.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatApp"
        Height="650"
        Width="1000"
        MinHeight="450"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Connection bar -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Server host"
                               Margin="0,0,0,5"
                               Foreground="#526078"/>
                    <TextBox x:Name="HostBox"
                             Text="127.0.0.1"
                             Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Username"
                               Margin="0,0,0,5"
                               Foreground="#526078"/>
                    <TextBox x:Name="UsernameBox"
                             Padding="8" Text="alice" TextChanged="UsernameBox_TextChanged"/>
                </StackPanel>

                <Button x:Name="ConnectButton"
                        Grid.Column="2"
                        Content="Connect"
                        Padding="18,8"
                        Margin="0,21,14,0"
                        VerticalAlignment="Top"
                        Click="ConnectButton_Click"/>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="Connection status"
                               Margin="0,0,0,5"
                               Foreground="#526078"/>
                    <TextBlock x:Name="StatusText"
                               Text="Disconnected"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main chat area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Online users"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <ListBox x:Name="OnlineList"
                             BorderThickness="0"
                             Background="Transparent"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="10"
                    Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Chat"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <ListBox x:Name="MessagesList"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Message input -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="12"
                Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageInput"
                         Grid.Column="0"
                         Padding="10"
                         VerticalContentAlignment="Center"
                         ToolTip="Type a message..."
                         KeyDown="MessageInput_KeyDown" TextChanged="MessageInput_TextChanged"/>

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="Send"
                        Padding="22,8"
                        Margin="10,0,0,0"
                        Click="SendButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
